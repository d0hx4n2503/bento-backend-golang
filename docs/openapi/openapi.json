{
  "openapi": "3.0.3",
  "info": {
    "title": "Bento Go Backend API",
    "version": "development",
    "description": "HTTP endpoints currently registered by the Go backend. Session endpoints issue or consume HttpOnly cookies; the refresh cookie is scoped to /api/v1/auth/refresh."
  },
  "servers": [
    {
      "url": "/",
      "description": "Current API origin"
    }
  ],
  "tags": [
    { "name": "System", "description": "Service metadata, health, and metrics." },
    { "name": "Authentication", "description": "Session and authenticated-user endpoints." },
    { "name": "Sign-in", "description": "External identity sign-in endpoints." }
  ],
  "paths": {
    "/": {
      "get": {
        "tags": ["System"],
        "summary": "Get service metadata",
        "operationId": "getServiceMetadata",
        "responses": {
          "200": {
            "description": "Service metadata.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ServiceMetadata" },
                "example": { "service": "bento-backend-golang", "version": "development" }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "tags": ["System"],
        "summary": "Check API and MongoDB readiness",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "The API and MongoDB are ready.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Health" } } }
          },
          "503": {
            "description": "MongoDB is unavailable.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Health" } } }
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "tags": ["System"],
        "summary": "Read Prometheus metrics",
        "operationId": "getMetrics",
        "responses": {
          "200": {
            "description": "Prometheus exposition data.",
            "content": { "text/plain": { "schema": { "type": "string" } } }
          }
        }
      }
    },
    "/api/v1/auth/admin-login": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Start an admin session",
        "description": "Available only when admin credentials are configured. On success, sets access_token and refresh_token cookies.",
        "operationId": "adminLogin",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AdminLoginRequest" } } }
        },
        "responses": {
          "200": {
            "description": "Session created; session cookies are set by the response.",
            "headers": { "Set-Cookie": { "$ref": "#/components/headers/SetCookie" } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Success" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Rotate the session tokens",
        "description": "Reads the refresh_token cookie and replaces both session cookies. When CSRF protection is enabled, send the csrf_token cookie value in X-CSRF-Token.",
        "operationId": "refreshSession",
        "security": [{ "RefreshTokenCookie": [] }],
        "parameters": [{ "$ref": "#/components/parameters/CsrfToken" }],
        "responses": {
          "200": {
            "description": "Session refreshed; session cookies are replaced.",
            "headers": { "Set-Cookie": { "$ref": "#/components/headers/SetCookie" } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Success" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "500": { "$ref": "#/components/responses/InternalServerError" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": ["Authentication"],
        "summary": "End the current session",
        "description": "Clears access_token, refresh_token, and csrf_token cookies if present. When CSRF protection is enabled and session cookies are present, send the csrf_token cookie value in X-CSRF-Token.",
        "operationId": "logout",
        "parameters": [{ "$ref": "#/components/parameters/CsrfToken" }],
        "responses": {
          "200": { "description": "Session cookies cleared.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Success" } } } },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/api/v1/auth/check": {
      "get": {
        "tags": ["Authentication"],
        "summary": "Get the authenticated user",
        "description": "Accepts an Authorization: Bearer token or the access_token cookie.",
        "operationId": "checkSession",
        "security": [{ "BearerAuth": [] }, { "AccessTokenCookie": [] }],
        "responses": {
          "200": {
            "description": "Authenticated user details.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthenticatedUserResponse" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/api/v2/sign-in/google": {
      "post": {
        "tags": ["Sign-in"],
        "summary": "Sign in with Google",
        "description": "Accepts the Google OAuth access token in the legacy idToken field. On success, sets access_token and refresh_token cookies.",
        "operationId": "googleSignIn",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GoogleSignInRequest" } } }
        },
        "responses": {
          "200": {
            "description": "Session created; session cookies are set by the response.",
            "headers": { "Set-Cookie": { "$ref": "#/components/headers/SetCookie" } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Success" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "502": { "$ref": "#/components/responses/BadGateway" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT", "description": "Access token for the authenticated-user endpoint." },
      "AccessTokenCookie": { "type": "apiKey", "in": "cookie", "name": "access_token" },
      "RefreshTokenCookie": { "type": "apiKey", "in": "cookie", "name": "refresh_token" },
      "CsrfHeader": { "type": "apiKey", "in": "header", "name": "X-CSRF-Token" }
    },
    "parameters": {
      "CsrfToken": {
        "name": "X-CSRF-Token",
        "in": "header",
        "required": false,
        "description": "Required only when CSRF protection is enabled and session cookies are sent. Use the csrf_token cookie value.",
        "schema": { "type": "string" }
      }
    },
    "headers": {
      "SetCookie": {
        "description": "Sets one or more HttpOnly session cookies. When CSRF is enabled, also sets the readable csrf_token cookie.",
        "schema": { "type": "string" }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "The request body or required fields are invalid.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } }
      },
      "Unauthorized": {
        "description": "Credentials are missing, invalid, or expired.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } }
      },
      "Forbidden": {
        "description": "CSRF validation failed.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } }
      },
      "Conflict": {
        "description": "The Google identity is linked to a different account.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } }
      },
      "BadGateway": {
        "description": "The Google sign-in provider could not be reached or returned an unusable response.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } }
      },
      "RateLimited": {
        "description": "The request rate limit was exceeded.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } }
      },
      "ServiceUnavailable": {
        "description": "A required service is unavailable.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } }
      },
      "InternalServerError": {
        "description": "The server could not complete the request.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } }
      }
    },
    "schemas": {
      "ServiceMetadata": {
        "type": "object",
        "required": ["service", "version"],
        "properties": {
          "service": { "type": "string", "example": "bento-backend-golang" },
          "version": { "type": "string", "example": "development" }
        }
      },
      "Health": {
        "type": "object",
        "required": ["status", "timestamp", "services"],
        "properties": {
          "status": { "type": "string", "enum": ["ok", "unavailable"] },
          "timestamp": { "type": "string", "format": "date-time" },
          "services": {
            "type": "object",
            "required": ["api", "database"],
            "properties": {
              "api": { "type": "string", "enum": ["up"] },
              "database": { "type": "string", "enum": ["up", "down"] }
            }
          }
        }
      },
      "AdminLoginRequest": {
        "type": "object",
        "required": ["username", "password"],
        "properties": {
          "username": { "type": "string", "example": "admin" },
          "password": { "type": "string", "format": "password", "writeOnly": true }
        }
      },
      "GoogleSignInRequest": {
        "type": "object",
        "required": ["idToken"],
        "properties": {
          "idToken": { "type": "string", "description": "Google OAuth access token accepted by the current backend contract.", "writeOnly": true }
        }
      },
      "Success": {
        "type": "object",
        "required": ["success"],
        "properties": { "success": { "type": "boolean", "example": true } }
      },
      "AuthenticatedUserResponse": {
        "type": "object",
        "required": ["success", "user"],
        "properties": {
          "success": { "type": "boolean", "example": true },
          "user": {
            "type": "object",
            "required": ["id", "email", "role"],
            "properties": {
              "id": { "type": "string" },
              "email": { "type": "string", "format": "email" },
              "role": { "type": "string" }
            }
          }
        }
      },
      "ApiError": {
        "type": "object",
        "required": ["success", "error"],
        "properties": {
          "success": { "type": "boolean", "example": false },
          "error": {
            "type": "object",
            "required": ["message", "requestId"],
            "properties": {
              "message": { "type": "string" },
              "requestId": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
